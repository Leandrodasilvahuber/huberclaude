---
import BaseLayout from '../layouts/BaseLayout.astro'
import CopyCommand from '../components/CopyCommand.astro'
import Terminal from '../components/Terminal.astro'
import { SITE } from '../data/site'
import { partners, community } from '../data/partners'

const features = [
  {
    title: 'openrouter, nothing else',
    body: 'one key, the whole openrouter catalog: claude, gpt, gemini, deepseek, qwen, glm, kimi. run /login once and skip the provider setup.',
    href: '/docs/providers/',
    link: 'openrouter setup →',
  },
  {
    title: 'see what you spend',
    body: '/usage shows your openrouter balance as a fuel gauge scaled to your last recharge, so you see the cost before the bill does.',
    href: '/docs/slash-commands/#models',
    link: 'model commands →',
  },
  {
    title: 'real tools, not just chat',
    body: 'bash, file edits, grep, glob, mcp servers, skills, sub-agents — wired into the agent loop, not bolted on.',
    href: '/docs/slash-commands/',
    link: 'command reference →',
  },
  {
    title: 'scriptable from day one',
    body: 'non-interactive --print mode with json and stream-json output, tool allowlists, budgets, and session control.',
    href: '/docs/cli-reference/',
    link: 'cli reference →',
  },
  {
    title: 'sessions that persist',
    body: 'resume, branch, and rewind conversations. background sessions keep long tasks running out of your way.',
    href: '/docs/slash-commands/#session',
    link: 'session commands →',
  },
]

const models = [
  'Claude', 'GPT', 'Gemini', 'DeepSeek', 'Qwen', 'GLM',
  'Kimi', 'Grok', 'Llama', 'Mistral', 'MiniMax', 'Gemma',
]

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'huberclaude',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux, Windows',
    url: SITE.url,
    downloadUrl: SITE.npmUrl,
    description: SITE.description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Person', name: 'Leandro Huber', url: SITE.github },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
  },
]
---

<BaseLayout title={SITE.title} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero grid-bg" aria-labelledby="hero-heading">
    <div class="container hero-inner">
      <p class="pill fade-up"><span class="dot" aria-hidden="true"></span>open source · openrouter-only · token-frugal</p>
      <h1 id="hero-heading" class="text-hero fade-up fade-up-1">
        one key.<br />every model.
      </h1>
      <p class="hero-sub fade-up fade-up-2">
        an open coding agent for your terminal, built only for openrouter.
      </p>
      <div class="hero-cta fade-up fade-up-3">
        <CopyCommand command={SITE.installCommand} />
        <a class="button button-ghost" href="/docs/quickstart/">read the docs →</a>
      </div>
      <p class="hero-foot fade-up fade-up-4">
        claude, gpt, gemini, deepseek, qwen, glm, and the rest of the openrouter catalog.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="demo-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">// in action</p>
        <h2 id="demo-heading">an agent loop you can watch.</h2>
      </div>
      <Terminal>
        <span class="ln"><span class="t-prompt">$</span> huberclaude</span>
        <span class="ln t-dim">huberclaude · openrouter · qwen/qwen3-coder</span>
        <span class="ln">&nbsp;</span>
        <span class="ln"><span class="t-prompt">&gt;</span> add retry with backoff to the fetch client</span>
        <span class="ln">&nbsp;</span>
        <span class="ln"><span class="t-info">●</span> Read src/lib/fetchClient.ts</span>
        <span class="ln"><span class="t-info">●</span> Grep "fetchWithTimeout" — 3 matches</span>
        <span class="ln"><span class="t-ok">●</span> Edit src/lib/fetchClient.ts <span class="t-dim">+18 -2</span></span>
        <span class="ln"><span class="t-ok">●</span> Bash bun test fetchClient <span class="t-dim">— 7 pass</span></span>
        <span class="ln">&nbsp;</span>
        <span class="ln t-dim">added exponential backoff (3 retries, jitter). tests green.</span>
        <span class="ln cursor">&nbsp;</span>
      </Terminal>
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="features-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">// features</p>
        <h2 id="features-heading">built for agents that ship code.</h2>
      </div>
      <div class="card-grid">
        {features.map(f => (
          <a class="card" href={f.href}>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
            <span class="card-link">{f.link}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="providers-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">// openrouter</p>
        <h2 id="providers-heading">one key. the whole catalog.</h2>
        <p class="lede">
          paste your openrouter key with <code>/login</code>, pick a model with
          <code>/model</code>, and switch mid-session. no provider setup.
        </p>
      </div>
      <ul class="provider-strip" aria-label="model families on openrouter">
        {models.map(m => <li>{m}</li>)}
      </ul>
      <p class="text-body-dim provider-foot">
        and every other model openrouter serves. <a href="/docs/providers/">openrouter setup →</a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="buddy-heading">
    <div class="container buddy-teaser">
      <div class="buddy-copy">
        <p class="eyebrow">// buddy</p>
        <h2 id="buddy-heading">ship with a hero at your side.</h2>
        <p class="lede">
          hatch a pixel-art companion who lives beside your prompt and fires an arrow —
          or an energy wave, or dragon fire — every time you press enter. seven heroes,
          rarity rolls, zero tokens.
        </p>
        <a class="button button-ghost" href="/buddy/">meet the heroes →</a>
      </div>
      <div class="buddy-art">
        <img src="/buddy/robinhood-action.svg" alt="Robin Hood pixel-art buddy firing an arrow" width="368" height="128" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="partners-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">// partners</p>
        <h2 id="partners-heading">backed by teams betting on open agents.</h2>
      </div>
      <ul class="partner-strip" aria-label="partners">
        {partners.map(p => (
          <li>
            <a href={p.url} rel="noopener sponsored" aria-label={p.name}>
              {p.logoDark ? (
                <>
                  <img class="logo-light" src={p.logo} alt={`${p.name} logo`} style={`height:${p.height}px`} loading="lazy" />
                  <img class="logo-dark" src={p.logoDark} alt={`${p.name} logo`} style={`height:${p.height}px`} loading="lazy" />
                </>
              ) : (
                <img src={p.logo} alt={`${p.name} logo`} style={`height:${p.height}px`} loading="lazy" />
              )}
              <span>{p.name}</span>
            </a>
          </li>
        ))}
      </ul>
      <ul class="community-strip" aria-label="community links">
        {community.map(c => (
          <li><a href={c.url} rel="noopener">[{c.label}]</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="install-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">// install</p>
        <h2 id="install-heading">build it. then write a task.</h2>
      </div>
      <div class="install-grid">
        <CopyCommand command={SITE.installCommand} />
        <ol class="install-steps">
          <li>
            <span class="step-num">01</span>
            <div>
              <strong>install</strong>
              <p>build from source; needs node ≥ 22 and bun. <a href="/docs/installation/">install guide →</a></p>
            </div>
          </li>
          <li>
            <span class="step-num">02</span>
            <div>
              <strong>start</strong>
              <p>run <code>huberclaude</code> in any repo, then <code>/login</code> with your openrouter key.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: calc(var(--nav-h) + clamp(4rem, 12vh, 7rem)) 0 clamp(3.5rem, 9vh, 6rem);
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.4rem;
    position: relative;
  }
  .hero-sub {
    max-width: 36rem;
    margin: 0;
    color: var(--muted);
    font-size: clamp(0.9rem, 1.4vw, 1rem);
    line-height: 1.7;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }
  .hero-foot {
    margin: 0.4rem 0 0;
    color: var(--faint);
    font-size: 0.73rem;
    letter-spacing: 0.02em;
  }

  .provider-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    background: var(--line);
  }
  .provider-strip li {
    flex: 1 1 auto;
    padding: 0.85rem 1.2rem;
    background: var(--background);
    color: var(--muted);
    font-size: 0.78rem;
    text-align: center;
    white-space: nowrap;
  }
  .provider-foot { margin-top: 1.25rem; }
  .provider-foot a { color: var(--accent); }

  .install-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 36rem;
  }
  .install-grid :global(.copy-cmd) { width: 100%; justify-content: flex-start; }
  .install-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .install-steps li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .step-num {
    color: var(--accent);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    padding-top: 0.18rem;
  }
  .install-steps strong {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 600;
  }
  .install-steps p { margin: 0; color: var(--muted); font-size: 0.85rem; line-height: 1.6; }
  .install-steps a { color: var(--accent); }

  .buddy-teaser {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .buddy-teaser { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
  }
  .buddy-copy h2 { margin: 0.85rem 0 0; }
  .buddy-copy .lede { margin: 0.85rem 0 1.25rem; color: var(--muted); }
  .buddy-art {
    display: flex;
    justify-content: center;
    padding: 1.25rem;
    border: 1px solid var(--line);
    background: var(--background);
  }
  .buddy-art img {
    width: min(368px, 70vw);
    height: auto;
    image-rendering: pixelated;
  }

  .partner-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    background: var(--line);
  }
  .partner-strip li { flex: 1 1 9rem; background: var(--background); }
  .partner-strip a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    height: 100%;
    padding: 1.4rem 1rem;
    text-decoration: none;
  }
  .partner-strip img { max-width: 8.5rem; width: auto; object-fit: contain; }
  .partner-strip span {
    color: var(--faint);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }
  .partner-strip a:hover span { color: var(--ink); }
  .logo-dark { display: none; }
  :global([data-theme='light']) .logo-dark { display: none !important; }
  :global([data-theme='light']) .logo-light { display: block; }
  :global(html:not([data-theme='light'])) .logo-dark { display: block; }
  :global(html:not([data-theme='light'])) .logo-light { display: none; }

  .community-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.75rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .community-strip a {
    color: var(--muted);
    font-size: 0.78rem;
    text-decoration: none;
  }
  .community-strip a:hover { color: var(--accent); }
</style>
