---
import DocsLayout from '../../layouts/DocsLayout.astro'
import { docsNav } from '../../data/docsNav'
import { SITE } from '../../data/site'

const toc = [
  { id: 'what-is-huberclaude', label: 'what is huberclaude' },
  { id: 'sections', label: 'documentation sections' },
]
---

<DocsLayout
  title="huberclaude documentation — CLI guides & reference"
  description="Documentation for the huberclaude CLI: installation, quickstart, OpenRouter setup, slash commands, CLI flags, configuration, and keybindings."
  heading="huberclaude documentation"
  lede="Everything you need to install the agent, sign in to OpenRouter, and drive it from your terminal."
  toc={toc}
>
  <h2 id="what-is-huberclaude">what is huberclaude</h2>
  <p>
    huberclaude is an open-source coding agent that runs in your terminal. It reads and edits
    files, runs shell commands, searches your codebase, and talks to MCP servers. It is
    dedicated to <a href="/docs/providers/">OpenRouter</a>: one API key, the whole model
    catalog, and no provider setup.
  </p>
  <p>
    huberclaude is a fork of <a href={SITE.upstream} rel="noopener">openclaude</a> and is
    developed in the open on <a href={SITE.github} rel="noopener">GitHub</a>.
  </p>
  <pre><code>{SITE.installCommand}</code></pre>

  <h2 id="sections">documentation sections</h2>
  {docsNav.map(group => (
    <>
      <h3 id={group.group.replace(/\s+/g, '-')}>{group.group}</h3>
      <ul>
        {group.items
          .filter(item => item.href !== '/docs/')
          .map(item => (
            <li><a href={item.href} rel={item.newTab ? 'noopener' : undefined} target={item.newTab ? '_blank' : undefined}>{item.title}</a></li>
          ))}
      </ul>
    </>
  ))}
</DocsLayout>
