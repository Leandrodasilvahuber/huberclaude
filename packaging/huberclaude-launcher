#!/bin/sh
# Launcher do HuberClaude.
# Se o pacote embutiu o Node (WITH_NODE=1) usa /usr/lib/huberclaude/node/bin/node;
# caso contrario usa o Node do sistema, que precisa ser 22 ou mais novo (conferido abaixo).
NODE=""
if [ -x /usr/lib/huberclaude/node/bin/node ]; then
  NODE=/usr/lib/huberclaude/node/bin/node
else
  NODE="$(command -v node || true)"
fi
if [ -z "$NODE" ]; then
  echo "huber: Node.js 22 or newer is required. Install it from https://nodejs.org (or your distro) and try again." >&2
  exit 1
fi
MAJOR="$("$NODE" -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
if [ "$MAJOR" -lt 22 ] 2>/dev/null; then
  echo "huber: Node.js 22 or newer is required (found $("$NODE" --version 2>/dev/null)). Update it from https://nodejs.org and try again." >&2
  exit 1
fi
exec "$NODE" /usr/lib/huberclaude/bin/openclaude "$@"
